@{
    Layout = "_RoleLayout";
    ViewData["Title"] = "Thanh toán Buy It Now";
}
<link rel="stylesheet" href="~/css/immediate-checkout.css" asp-append-version="true" />
<section
    class="panel active immediate-page immediate-checkout-page"
    id="buyer-immediate-checkout"
>
    <a href="/Buyer/Products">← Quay lại danh sách sản phẩm</a>
    <div class="section-head">
        <div>
            <span class="eyebrow">Người mua</span>
            <h1>Thanh toán</h1>
            <p>Kiểm tra sản phẩm, địa chỉ, mã giảm giá rồi thanh toán.</p>
        </div>
    </div>
    <div id="message" class="message" role="status" aria-live="polite"></div>
    <div id="checkout-content" class="checkout-grid">
        <div class="checkout-main">
            <div class="block">
                <h2>Sản phẩm</h2>
                <div id="checkout-product"></div>
            </div>
            <form id="buy-now-form" class="block">
                <h2>Giao đến</h2>
                <label for="buy-address">Địa chỉ giao hàng</label>
                <select id="buy-address" required></select>
                <p><a href="/Buyer">Quản lý địa chỉ trong Giỏ hàng</a></p>
                <label for="buy-quantity">Số lượng (1–5)</label>
                <input
                    id="buy-quantity"
                    type="number"
                    min="1"
                    max="5"
                    step="1"
                    value="1"
                    required
                />
                <label for="buy-coupon">Mã giảm giá</label>
                <input id="buy-coupon" maxlength="50" />
                <button type="submit" id="review-checkout">Xem báo giá</button>
            </form>
            <section id="immediate-payment" class="block" hidden>
                <h2>Phương thức thanh toán</h2>
                <label class="payment-option">
                    <input type="radio" name="method" value="card" checked />
                    <span>
                        <strong>Thẻ tín dụng giả lập</strong>
                        <small>Không nhập thông tin thẻ thật</small>
                    </span>
                </label>
                <form id="pay-now-form" class="card-fields">
                    <p class="small">
                        Thẻ thử: 4111111111111111 thành công; 4000000000000002 bị từ chối.
                    </p>
                    <label for="card-number">Số thẻ thử</label>
                    <input id="card-number" inputmode="numeric" autocomplete="off" required />
                    <label for="card-expiry">Hết hạn MM/YY</label>
                    <input id="card-expiry" placeholder="12/30" autocomplete="off" required />
                    <button type="submit" id="pay-now" class="primary">Pay Now</button>
                </form>
                <button type="button" id="check-payment" hidden>
                    Kiểm tra kết quả thanh toán
                </button>
            </section>
        </div>
        <aside class="total-card">
            <h2>Tổng kết đơn hàng</h2>
            <div id="checkout-quote">
                <p class="small">Chọn địa chỉ, số lượng rồi bấm “Xem báo giá”.</p>
            </div>
        </aside>
    </div>
    <section id="payment-success" hidden role="status">
        <h2>Payment Success</h2>
        <p id="paid-order"></p>
        <a href="/Buyer?tab=orders">Xem lịch sử đơn hàng</a>
    </section>
</section>
@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/product-page-navigation.js" asp-append-version="true"></script>
    <script src="~/js/immediate-checkout.js" asp-append-version="true"></script>
}
