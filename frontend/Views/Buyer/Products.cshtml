@{
    Layout = "_RoleLayout";
    ViewData["Title"] = "Sản phẩm";
}
<link rel="stylesheet" href="~/css/buyer-products.css" asp-append-version="true" />
<section class="panel active buyer-products-page" id="buyer-products">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người mua</span>
            <h1>Sản phẩm</h1>
            <p>
                Mua ngay một món bằng Buy It Now, thêm vào giỏ để thanh toán nhiều món,
                hoặc trả giá nếu người bán cho phép.
            </p>
        </div>
        <a class="button-link" href="/Buyer?tab=summary">Xem giỏ hàng</a>
    </div>
    <div id="message" class="products-message" role="status" aria-live="polite"></div>
    <div id="products-list" class="products-grid" aria-busy="true">Đang tải…</div>
</section>
@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/product-page-navigation.js" asp-append-version="true"></script>
    <script src="~/js/buyer-products.js" asp-append-version="true"></script>
}
