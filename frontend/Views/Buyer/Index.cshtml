@{ Layout = "_RoleLayout"; ViewData["Title"] = "Buyer"; }
<nav class="tabs role-tabs"><button data-tab="summary" class="active">Order Summary</button><button data-tab="checkout">Checkout</button><button data-tab="orders">Đơn của tôi</button></nav>
<div id="message" class="message" role="status"></div>
<section id="summary" class="panel tab-panel active"><div class="section-head"><div><span class="eyebrow">Buyer</span><h1>Order Summary</h1><p>Tạo giỏ từ sản phẩm đang có trong SQL Server.</p></div></div><div class="toolbar"><label for="count">Số sản phẩm</label><select id="count"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option></select><button class="primary" id="random">Tạo giỏ ngẫu nhiên</button></div><div id="cart" class="item-list empty">Chọn số sản phẩm rồi tạo giỏ.</div><div class="summary-footer"><strong id="cart-subtotal">Tạm tính: $0.00</strong><button id="continue" class="primary" disabled>Tiếp tục checkout</button></div></section>
<section id="checkout" class="panel tab-panel"><div class="section-head"><div><span class="eyebrow">Buyer</span><h1>Checkout</h1><p>Địa chỉ, coupon và phương thức thanh toán.</p></div></div><div class="checkout-grid"><div class="checkout-main"><div class="block"><h2>Ship to</h2><label for="address">Địa chỉ</label><select id="address"></select><button id="edit-address" type="button" class="text-button">Sửa địa chỉ</button><div id="address-fields" class="address-fields hidden"><label for="address-name">Họ tên</label><input id="address-name"/><label for="address-street">Đường</label><input id="address-street"/><label for="address-city">Thành phố</label><input id="address-city"/><label for="address-state">Tỉnh/khu vực</label><input id="address-state"/><label for="address-country">Quốc gia</label><input id="address-country"/><button id="save-address">Lưu địa chỉ</button></div></div><div class="block"><h2>Pay with</h2><label class="payment-option"><input type="radio" name="method" value="paypal" checked/><span><strong>PayPal Sandbox</strong><small>Tài khoản sandbox</small></span></label><label class="payment-option"><input type="radio" name="method" value="card"/><span><strong>Credit Card giả lập</strong><small>Không nhập thẻ thật</small></span></label><div id="card-fields" class="card-fields hidden"><label for="card-number">Thẻ thử</label><select id="card-number"><option value="4111111111111111">4111...1111 — thành công</option><option value="4000000000000002">4000...0002 — từ chối</option></select><label for="card-expiry">Hạn</label><input id="card-expiry" value="12/30"/></div></div><div class="block"><h2>Sản phẩm</h2><div id="checkout-items" class="item-list"></div></div></div><aside class="total-card"><h2>Order Summary</h2><label for="coupon">Coupon</label><div class="coupon-row"><input id="coupon" placeholder="G4SAVE10"/><button id="apply-coupon">Áp dụng</button></div><dl><div><dt>Tiền hàng</dt><dd id="subtotal">$0.00</dd></div><div><dt>Giảm</dt><dd id="discount">-$0.00</dd></div><div><dt>Ship</dt><dd id="shipping">$0.00</dd></div><div class="grand"><dt>Tổng</dt><dd id="total">$0.00</dd></div></dl><button class="primary wide" id="pay" disabled>Thanh toán</button></aside></div></section>
<section id="orders" class="panel tab-panel"><div class="section-head"><div><span class="eyebrow">Buyer</span><h1>Đơn của tôi</h1><p>Thanh toán, tracking, hủy, trả hàng và tranh chấp.</p></div><button id="refresh-orders">Làm mới</button></div><label for="order-filter">Lọc</label><select id="order-filter"><option value="all">Tất cả</option><option value="pending">Chờ xử lý</option><option value="shipping">Đang giao</option><option value="complete">Hoàn tất</option><option value="cancelled">Đã hủy</option></select><div id="order-list" class="order-list"></div><div id="order-detail"></div></section>
@section Scripts { <script src="~/js/common.js"></script><script src="~/js/buyer.js"></script> }
