@{
    Layout = "_RoleLayout";
    ViewData["Title"] = "Người mua";
}
<nav class="tabs role-tabs">
    <button data-tab="summary" class="active">Giỏ hàng</button>
    <button data-tab="checkout">Thanh toán</button>
    <button data-tab="orders">Đơn của tôi</button>
    <button data-tab="disputes">
        Tranh chấp
        <span id="dispute-tab-count"></span>
    </button>
</nav>
<link rel="stylesheet" href="~/css/promotions.css" asp-append-version="true" />
<div id="message" class="message" role="status" aria-live="polite"></div>
<section id="summary" class="panel tab-panel active">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người mua</span>
            <h1>Giỏ hàng</h1>
            <p>Tạo giỏ từ các sản phẩm hiện có.</p>
        </div>
    </div>
    <div class="toolbar">
        <label for="count">Số sản phẩm</label>
        <select id="count">
            <option>1</option>
            <option>2</option>
            <option selected>3</option>
            <option>4</option>
            <option>5</option>
        </select>
        <button class="primary" id="random">Tạo giỏ ngẫu nhiên</button>
    </div>
    <div id="cart" class="item-list empty">Chọn số sản phẩm rồi tạo giỏ.</div>
    <div class="summary-footer">
        <strong id="cart-subtotal">Tạm tính: $0.00</strong>
        <button id="continue" class="primary" disabled>Tiếp tục thanh toán</button>
    </div>
</section>
<section id="checkout" class="panel tab-panel">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người mua</span>
            <h1>Thanh toán</h1>
            <p>Kiểm tra địa chỉ, mã giảm giá và phương thức thanh toán.</p>
        </div>
    </div>
    <div class="checkout-grid">
        <div class="checkout-main">
            <div class="block">
                <h2>Giao đến</h2>
                <label for="address">Địa chỉ</label>
                <select id="address"></select>
                <button id="edit-address" type="button" class="text-button">Sửa địa chỉ</button>
                <div id="address-fields" class="address-fields hidden">
                    <label for="address-name">Họ tên</label>
                    <input id="address-name"/>
                    <label for="address-street">Đường</label>
                    <input id="address-street"/>
                    <label for="address-city">Thành phố</label>
                    <input id="address-city"/>
                    <label for="address-state">Tỉnh/khu vực</label>
                    <input id="address-state"/>
                    <label for="address-country">Quốc gia</label>
                    <input id="address-country"/>
                    <button id="save-address">Lưu địa chỉ</button>
                </div>
            </div>
            <div class="block">
                <h2>Phương thức thanh toán</h2>
                <label class="payment-option">
                    <input type="radio" name="method" value="paypal" checked/>
                    <span>
                        <strong>PayPal thử nghiệm</strong>
                        <small>Tài khoản thử nghiệm</small>
                    </span>
                </label>
                <label class="payment-option">
                    <input type="radio" name="method" value="card"/>
                    <span>
                        <strong>Thẻ tín dụng giả lập</strong>
                        <small>Không nhập thông tin thẻ thật</small>
                    </span>
                </label>
                <div id="card-fields" class="card-fields hidden">
                    <label for="card-number">Thẻ thử</label>
                    <select id="card-number">
                        <option value="4111111111111111">4111...1111 — thành công</option>
                        <option value="4000000000000002">4000...0002 — từ chối</option>
                    </select>
                    <label for="card-expiry">Hạn</label>
                    <input id="card-expiry" value="12/30"/>
                </div>
            </div>
            <div class="block">
                <h2>Sản phẩm</h2>
                <div id="checkout-items" class="item-list"></div>
            </div>
        </div>
        <aside class="total-card">
            <h2>Tổng kết đơn hàng</h2>
            <label for="coupon">Mã giảm giá</label>
            <div class="coupon-row">
                <input id="coupon" placeholder="G4SAVE10"/>
                <button id="apply-coupon">Áp dụng</button>
            </div>
            <dl>
                <div><dt>Khối lượng</dt><dd id="checkout-weight">0 kg</dd></div>
                <div>
                    <dt>Tiền hàng</dt>
                    <dd id="subtotal">$0.00</dd>
                </div>
                <div>
                    <dt>Giảm tiền hàng</dt>
                    <dd id="discount">-$0.00</dd>
                </div>
                <div>
                    <dt>Phí vận chuyển</dt>
                    <dd id="shipping">$0.00</dd>
                </div>
                <div class="grand">
                    <dt>Tổng</dt>
                    <dd id="total">$0.00</dd>
                </div>
            </dl>
            <div id="checkout-promotions" aria-live="polite"></div>
            <p id="checkout-promotion-note" class="promotion-checkout-note" hidden></p>
            <button type="button" id="refresh-quote" class="wide">Cập nhật báo giá</button>
            <p class="promotion-checkout-note">Báo giá chưa giữ lượt khuyến mãi. Giá được xác nhận khi tạo đơn.</p>
            <button class="primary wide" id="pay" disabled>Thanh toán</button>
        </aside>
    </div>
</section>
<section id="orders" class="panel tab-panel">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người mua</span>
            <h1>Đơn của tôi</h1>
            <p>Theo dõi thanh toán, giao hàng, hủy và trả hàng.</p>
        </div>
        <button id="refresh-orders">Làm mới</button>
    </div>
    <div class="seller-order-filters">
        <div class="seller-filter-tabs" role="group" aria-label="Lọc đơn hàng theo trạng thái">
            <button type="button" data-order-filter="all" class="active" aria-pressed="true">Tất cả <span data-filter-count="all">0</span></button>
            <button type="button" data-order-filter="unpaid" aria-pressed="false">Chờ thanh toán <span data-filter-count="unpaid">0</span></button>
            <button type="button" data-order-filter="ready" aria-pressed="false">Chờ giao <span data-filter-count="ready">0</span></button>
            <button type="button" data-order-filter="shipping" aria-pressed="false">Đang giao <span data-filter-count="shipping">0</span></button>
            <button type="button" data-order-filter="complete" aria-pressed="false">Đã kết thúc <span data-filter-count="complete">0</span></button>
            <button type="button" data-order-filter="cancelled" aria-pressed="false">Đã hủy <span data-filter-count="cancelled">0</span></button>
        </div>
        <p id="buyer-order-summary" class="small" role="status" aria-live="polite">Đang tải đơn hàng…</p>
    </div>
    <div id="order-list" class="order-list" aria-busy="false"></div>
    <div id="order-pagination" class="pagination"></div>
</section>
<div id="paypal-loading" class="loading-overlay hidden" role="status" aria-live="assertive">
    <div>
        <span class="spinner" aria-hidden="true"></span>
        <strong>Đang chuyển hướng đến PayPal</strong>
        <p>Vui lòng đợi trong giây lát...</p>
    </div>
</div>
<partial name="_DisputesPanel" model="false" />
@section Scripts
{
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/promotions.js" asp-append-version="true"></script>
    <script src="~/js/disputes.js" asp-append-version="true"></script>
    <script src="~/js/buyer.js" asp-append-version="true"></script>
}
