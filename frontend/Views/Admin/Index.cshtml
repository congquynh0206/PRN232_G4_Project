@{ Layout = "_RoleLayout"; ViewData["Title"] = "Quản trị viên"; }
<nav class="tabs role-tabs"><button data-tab="holds" class="active">Tranh chấp</button><button data-tab="inbox">Nhật ký thư điện tử</button></nav><div id="message" class="message" role="status" aria-live="polite"></div>
<section id="holds" class="panel tab-panel active"><div class="section-head"><div><span class="eyebrow">Quản trị viên</span><h1>Khoản tiền đang giữ</h1><p>Giải quyết tranh chấp và khoản tiền đang giữ.</p></div><button id="refresh-holds">Làm mới</button></div><div id="hold-list" class="order-list"></div><div id="hold-pagination" class="pagination"></div></section>
<section id="inbox" class="panel tab-panel"><div class="section-head"><div><span class="eyebrow">Quản trị viên</span><h1>Nhật ký thư điện tử</h1><p>Thông báo được ghi nhận bởi hệ thống.</p></div><button id="refresh-inbox">Làm mới</button></div><div id="email-list" class="order-list"></div><div id="email-pagination" class="pagination"></div></section>
@section Scripts { <script src="~/js/common.js" asp-append-version="true"></script><script src="~/js/admin.js" asp-append-version="true"></script> }
