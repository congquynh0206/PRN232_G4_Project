@{
    Layout = "_RoleLayout";
    ViewData["Title"] = "Sản phẩm";
}
<link rel="stylesheet" href="~/css/immediate-checkout.css" asp-append-version="true" />
<section class="panel active immediate-page" id="seller-products">
    <a href="/Seller">Quay lại quản lý đơn hàng</a>
    <h1>Sản phẩm và thanh toán</h1>
    <div id="message" role="status" aria-live="polite"></div>
    <form id="publish-product">
        <h2>Đăng sản phẩm</h2>
        <label>Tên sản phẩm <input name="title" maxlength="100" required /></label>
        <label>Mô tả <textarea name="description"></textarea></label>
        <label>Giá USD <input name="price" type="number" min="0.01" step="0.01" required /></label>
        <label>Khối lượng kg
            <input name="weightKg" type="number" min="0.001" step="0.001" required />
        </label>
        <label>Tồn kho <input name="quantity" type="number" min="1" step="1" required /></label>
        <label>Thanh toán
            <select name="immediatePaymentRequired">
                <option value="false">Normal Payment</option>
                <option value="true">Immediate Payment</option>
            </select>
        </label>
        <button type="submit">Đăng sản phẩm</button>
    </form>
    <h2>Sản phẩm của bạn</h2>
    <div id="products-list"></div>
</section>
@section Scripts {
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/product-page-navigation.js" asp-append-version="true"></script>
    <script src="~/js/seller-products.js" asp-append-version="true"></script>
}
