@{ Layout = "_RoleLayout"; ViewData["Title"] = "Seller"; }
<nav class="tabs role-tabs"><button data-tab="orders" class="active">Đơn hàng</button><button data-tab="finance">Tài chính</button></nav><div id="message" class="message"></div>
<section id="orders" class="panel tab-panel active"><div class="section-head"><div><span class="eyebrow">Seller</span><h1>Quản lý đơn hàng</h1><p>Chuẩn bị hàng, duyệt hủy/trả và hoàn tiền.</p></div><button id="refresh-orders">Làm mới</button></div><div id="order-list" class="order-list"></div><div id="order-detail"></div></section>
<section id="finance" class="panel tab-panel"><div class="section-head"><div><span class="eyebrow">Seller</span><h1>Tài chính người bán</h1><p>Phí nền tảng, số dư, level và payout.</p></div><button id="refresh-finance">Làm mới</button></div><div id="finance-balances" class="finance-grid"></div><div class="finance-columns"><div class="finance-block"><h2>Cấp người bán</h2><div id="finance-level"></div><button id="evaluate-level">Đánh giá lại cấp</button></div><div class="finance-block"><h2>Yêu cầu payout</h2><label for="payout-amount">Số tiền</label><input id="payout-amount" type="number" min="0.01" step="0.01"/><label class="check-row"><input id="payout-failure" type="checkbox"/> Giả lập ngân hàng trả lại</label><button class="primary" id="request-payout">Rút tiền</button></div></div><div class="finance-block"><h2>Nhật ký tài chính</h2><div id="finance-transactions" class="finance-list"></div></div><div class="finance-block"><h2>Payout</h2><div id="finance-payouts" class="finance-list"></div></div></section>
@section Scripts { <script src="~/js/common.js"></script><script src="~/js/seller.js"></script> }
