@{
    Layout = "_RoleLayout";
    ViewData["Title"] = "Người bán";
}
<nav class="tabs role-tabs">
    <button data-tab="orders" class="active">Đơn hàng</button>
    <button data-tab="finance">Tài chính</button>
    <button data-tab="finance-report">Báo cáo tài chính</button>
    <button data-tab="seller-returns">Trả hàng / Hoàn tiền <span id="seller-return-count"></span></button>
    <button data-tab="seller-levels">Cấp seller</button>
    <button data-tab="product-feedback">Đánh giá sản phẩm</button>
    <button data-tab="shipping-settings">Thiết lập giao hàng</button>
    <button data-tab="seller-identity">Định danh</button>
    <button data-tab="promotions">Khuyến mãi</button>
    <button data-tab="notifications">Email thông báo</button>
    <button data-tab="integration-logs">Nhật ký tích hợp</button>
    <button data-tab="disputes">
        Tranh chấp
        <span id="dispute-tab-count"></span>
    </button>
</nav>
<div id="message" class="message" role="status" aria-live="polite"></div>
<section id="orders" class="panel tab-panel active">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người bán</span>
            <h1>Quản lý đơn hàng</h1>
            <p>Chuẩn bị hàng, duyệt hủy/trả và hoàn tiền.</p>
        </div>
        <button id="refresh-orders">Làm mới</button>
    </div>
    <div class="seller-order-filters">
        <div
            id="seller-order-tabs"
            class="seller-filter-tabs"
            role="group"
            aria-label="Phân loại đơn hàng"
        >
            <button type="button" data-order-filter="all" class="active" aria-pressed="true">
                Tất cả <span data-filter-count="all">0</span>
            </button>
            <button type="button" data-order-filter="unpaid" aria-pressed="false">
                Chờ thanh toán <span data-filter-count="unpaid">0</span>
            </button>
            <button type="button" data-order-filter="ready" aria-pressed="false">
                Chờ giao <span data-filter-count="ready">0</span>
            </button>
            <button type="button" data-order-filter="shipping" aria-pressed="false">
                Đang giao <span data-filter-count="shipping">0</span>
            </button>
            <button type="button" data-order-filter="complete" aria-pressed="false">
                Đã kết thúc <span data-filter-count="complete">0</span>
            </button>
            <button type="button" data-order-filter="cancelled" aria-pressed="false">
                Đã hủy <span data-filter-count="cancelled">0</span>
            </button>
        </div>
        <div class="seller-filter-tools">
            <label class="seller-attention-filter" for="seller-needs-action">
                <input type="checkbox" id="seller-needs-action" />
                Cần xử lý <span id="seller-action-count">0</span>
            </label>
            <p id="seller-order-summary" class="small" role="status" aria-live="polite"></p>
        </div>
    </div>
    <div id="order-list" class="order-list" aria-busy="false"></div>
    <div id="order-pagination" class="pagination"></div>
</section>
<section id="finance" class="panel tab-panel">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người bán</span>
            <h1>Tài chính người bán</h1>
            <p>Phí nền tảng, số dư, cấp và rút tiền.</p>
        </div>
        <button id="refresh-finance">Làm mới</button>
    </div>
    <div id="finance-balances" class="finance-grid"></div>
    <div class="finance-block">
        <h2>Khoản nợ người bán</h2>
        <div id="seller-debt-summary" role="status" aria-live="polite"></div>
        <p class="small">Trả nợ bằng ngân hàng giả lập chỉ giảm số nợ. Không cộng tiền vào ví và không thu thêm phí nền tảng.</p>
        <form id="debt-repayment-form">
            <fieldset id="debt-repayment-fields">
                <label for="debt-repayment-amount">Số tiền trả nợ (USD)</label>
                <input id="debt-repayment-amount" type="number" min="0.01" step="0.01" required aria-describedby="debt-repayment-error" />
                <label class="check-row"><input id="debt-repayment-failure" type="checkbox" />Giả lập ngân hàng từ chối</label>
                <div class="actions">
                    <button type="button" id="debt-repayment-all">Điền toàn bộ số nợ</button>
                    <button type="submit" id="debt-repayment-submit" class="primary">Trả nợ</button>
                </div>
            </fieldset>
            <p id="debt-repayment-error" class="diagnostic-error" role="alert" tabindex="-1"></p>
            <p id="debt-repayment-result" role="status" aria-live="polite"></p>
        </form>
    </div>
    <div class="finance-block">
        <h2>Lịch sử khoản nợ</h2>
        <label for="seller-debt-history-kind">Loại lịch sử</label>
        <select id="seller-debt-history-kind">
            <option value="repayments">Biên nhận trả nợ</option>
            <option value="events">Cảnh báo và hạn chế</option>
            <option value="cycles">Các kỳ nợ</option>
        </select>
        <div id="seller-debt-history" aria-busy="false"></div>
        <div id="seller-debt-pagination" class="pagination"></div>
    </div>
    <div class="finance-columns">
        <div class="finance-block">
            <h2>Cấp người bán</h2>
            <div id="finance-level"></div>
            <button id="evaluate-level">Đánh giá lại cấp</button>
        </div>
        <div class="finance-block">
            <h2>Rút tiền ra ngân hàng giả lập</h2>
            <p class="small">Tiền khả dụng đã nằm trong ví. Thao tác này chuyển tiền từ ví ra ngân hàng giả lập; không cần để nhận tiền bán hàng vào ví.</p>
            <label for="payout-amount">Số tiền</label>
            <input id="payout-amount" type="number" min="0.01" step="0.01" />
            <label class="check-row">
                <input id="payout-failure" type="checkbox" />
                Giả lập ngân hàng trả lại
            </label>
            <button class="primary" id="request-payout">Rút tiền</button>
        </div>
    </div>
    <div class="finance-block">
        <h2>Nhật ký tài chính</h2>
        <div id="finance-transactions" class="finance-list"></div>
        <div id="finance-transactions-pagination" class="pagination"></div>
    </div>
    <div class="finance-block">
        <h2>Lịch sử rút tiền</h2>
        <div id="finance-payouts" class="finance-list"></div>
        <div id="finance-payouts-pagination" class="pagination"></div>
    </div>
</section>
<section id="finance-report" class="panel tab-panel">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người bán · USD</span>
            <h1>Báo cáo tài chính</h1>
            <p>Phát sinh bán hàng trong kỳ, không phải số dư ví hay tiền có thể rút.</p>
        </div>
        <button type="button" id="report-refresh">Làm mới</button>
    </div>
    <form id="report-filter" class="report-filters">
        <label>Khoảng thời gian
            <select id="report-preset">
                <option value="month" selected>Tháng này</option>
                <option value="today">Hôm nay</option>
                <option value="7">7 ngày</option>
                <option value="30">30 ngày</option>
                <option value="custom">Tùy chọn</option>
            </select>
        </label>
        <label>Từ ngày<input id="report-from" type="date" required></label>
        <label>Đến ngày<input id="report-to" type="date" required></label>
        <label>Nhóm theo
            <select id="report-group">
                <option value="day">Ngày</option>
                <option value="week">Tuần (thứ Hai)</option>
                <option value="month">Tháng</option>
            </select>
        </label>
        <button class="primary" type="submit">Áp dụng</button>
    </form>
    <p class="small">Payment theo PaidAt, refund theo CompletedAt; chi phí khác theo lúc ghi nhận. Ngày và nhóm kỳ theo múi giờ trình duyệt: <strong id="report-zone"></strong>. Khoảng tối đa 366 ngày; nhóm ngày tối đa 93 ngày.</p>
    <p id="report-status" role="status" aria-live="polite"></p>
    <div id="report-cards" class="report-cards"></div>
    <section class="finance-block" aria-labelledby="report-chart-title">
        <h2 id="report-chart-title">Xu hướng theo kỳ</h2>
        <div class="report-legend" aria-label="Chọn chuỗi hiển thị">
            <label><input type="checkbox" data-report-series="buyerPaid" checked> <span class="report-key paid"></span> Buyer đã trả</label>
            <label><input type="checkbox" data-report-series="buyerRefunded" checked> <span class="report-key refunded"></span> Đã hoàn</label>
            <label><input type="checkbox" data-report-series="net" checked> <span class="report-key net"></span> Net seller</label>
        </div>
        <div id="report-chart" class="report-chart"></div>
    </section>
    <section class="finance-block" aria-labelledby="report-table-title">
        <h2 id="report-table-title">Số liệu và bút toán nguồn</h2>
        <div class="report-table-wrap"><table class="report-table">
            <thead><tr><th>Kỳ</th><th>Số đơn đã trả</th><th>Buyer đã trả</th><th>Đã hoàn</th><th>Phí thực thu</th><th>Net seller</th></tr></thead>
            <tbody id="report-rows"></tbody>
        </table></div>
        <div id="report-pagination" class="pagination"></div>
    </section>
</section>
<partial name="_DisputesPanel" model="false" />
<section id="shipping-settings" class="panel tab-panel">
    <div class="section-head">
        <div>
            <span class="eyebrow">Người bán</span>
            <h1>Thiết lập giao hàng</h1>
            <p>Khai báo địa chỉ lấy hàng và khối lượng trước khi buyer checkout.</p>
        </div>
    </div>
    <form id="pickup-form" class="finance-block">
        <h2>Địa chỉ lấy hàng</h2>
        <div class="shipping-settings-fields">
            <label>Tên người gửi<input
                    id="pickup-fullName"
                    required
                    maxlength="100"
                    autocomplete="name"
            /></label>
            <label>Đường, số nhà<input
                    id="pickup-street"
                    required
                    maxlength="100"
                    autocomplete="street-address"
            /></label>
            <label>Thành phố<input
                    id="pickup-city"
                    required
                    maxlength="50"
                    autocomplete="address-level2"
            /></label>
            <label>Tỉnh / vùng<input
                    id="pickup-state"
                    required
                    maxlength="50"
                    placeholder="Hà Nội"
                    autocomplete="address-level1"
            /></label>
            <label>Quốc gia<input
                    id="pickup-country"
                    required
                    maxlength="50"
                    placeholder="Việt Nam"
                    autocomplete="country-name"
            /></label>
        </div>
        <button type="submit" class="primary">Lưu địa chỉ lấy hàng</button>
    </form>
    <form id="address-change-cap-form" class="finance-block">
        <h2>Đổi địa chỉ đơn hàng</h2>
        <p>
            Mức tăng phí ship tối đa bạn chấp nhận chịu cho một lần đổi địa chỉ. Mặc định 0 USD; yêu
            cầu vượt mức này tự bị từ chối.
        </p>
        <label for="address-change-cap">Mức chịu thêm phí ship (USD)</label>
        <input
            id="address-change-cap"
            type="number"
            min="0"
            max="10000"
            step="0.01"
            required
            value="0"
        />
        <button type="submit" class="primary">Lưu mức chịu phí</button>
    </form>
    <div class="finance-block">
        <h2>Khối lượng sản phẩm</h2>
        <p class="small">
            Đơn vị kg, tối đa 3 chữ số thập phân. Sản phẩm thiếu khối lượng chưa được checkout.
        </p>
        <div id="product-weights"></div>
        <div id="product-weights-pagination" class="pagination"></div>
    </div>
</section>
<partial name="_NotificationsPanel" />
<partial name="_SellerIdentityPanel" />
<partial name="_SellerReturnsPanel" />
<partial name="_SellerLevelsPanel" model="false" />
<partial name="_ProductFeedbackPanel" />
<partial name="_IntegrationLogsPanel" />
@section Scripts
{
<script src="~/js/common.js" asp-append-version="true"></script>
<script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
<script src="~/js/realtime.js" asp-append-version="true"></script>
<script src="~/js/address-changes.js" asp-append-version="true"></script>
<script src="~/js/returns.js" asp-append-version="true"></script>
<script src="~/js/notifications.js" asp-append-version="true"></script>
<script src="~/js/integration-logs.js" asp-append-version="true"></script>
<script src="~/js/promotions.js" asp-append-version="true"></script>
<script src="~/js/disputes.js" asp-append-version="true"></script>
<script src="~/js/seller-shipping.js" asp-append-version="true"></script>
<script src="~/js/seller-debt.js" asp-append-version="true"></script>
<script src="~/js/seller-identity.js" asp-append-version="true"></script>
<script src="~/js/seller-levels.js" asp-append-version="true"></script>
<script src="~/js/seller-returns.js" asp-append-version="true"></script>
<script src="~/js/product-feedback.js" asp-append-version="true"></script>
<script src="~/js/seller-report.js" asp-append-version="true"></script>
<script src="~/js/seller.js" asp-append-version="true"></script>
}
<partial name="_PromotionsPanel" model="false" />
