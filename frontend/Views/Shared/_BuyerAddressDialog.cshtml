<dialog
    id="address-dialog"
    class="action-dialog address-dialog"
    aria-labelledby="address-dialog-title"
>
    <div class="address-dialog-head">
        <h2 id="address-dialog-title">Quản lý địa chỉ</h2>
        <button type="button" id="address-dialog-close">Đóng</button>
    </div>
    <div class="address-dialog-body">
        <section class="address-pane address-pane-list" aria-label="Địa chỉ của bạn">
            <h3>Địa chỉ của bạn</h3>
            <div id="address-manage-list" class="address-manage-list"></div>
            <p id="address-limit" class="small" hidden>Đã đạt tối đa 10 địa chỉ. Hãy xóa bớt địa chỉ không dùng để thêm mới.</p>
        </section>
        <section class="address-pane address-pane-form" aria-label="Thêm hoặc sửa địa chỉ">
            <button type="button" id="address-add" class="primary">Thêm địa chỉ mới</button>
            <p id="address-form-placeholder" class="address-form-placeholder">Bấm “Thêm địa chỉ mới” hoặc “Sửa” ở một địa chỉ bên trái để nhập thông tin.</p>
            <form id="address-form" novalidate hidden>
                <h3 id="address-form-title">Thêm địa chỉ mới</h3>
                <label for="address-form-fullName">Tên người nhận</label>
                <input
                    id="address-form-fullName"
                    maxlength="100"
                    autocomplete="name"
                    aria-describedby="address-error-fullName"
                />
                <small id="address-error-fullName" class="field-error" role="alert"></small>
                <label for="address-form-phone">Số điện thoại người nhận</label>
                <input
                    id="address-form-phone"
                    maxlength="20"
                    type="tel"
                    inputmode="tel"
                    autocomplete="tel-national"
                    aria-describedby="address-error-phone"
                />
                <small id="address-error-phone" class="field-error" role="alert"></small>
                <label for="address-form-country">Quốc gia</label>
                <select
                    id="address-form-country"
                    autocomplete="country-name"
                    aria-describedby="address-error-country"
                ></select>
                <small id="address-error-country" class="field-error" role="alert"></small>
                <div class="address-lookup">
                    <label for="address-form-lookup">Tìm địa chỉ (số nhà, tên đường)</label>
                    <input
                        id="address-form-lookup"
                        maxlength="100"
                        placeholder="Ví dụ: 197 Trần Phú"
                    />
                </div>
                <label for="address-form-state">Tỉnh / thành phố</label>
                <select
                    id="address-form-state"
                    autocomplete="address-level1"
                    aria-describedby="address-error-state address-state-help"
                ></select>
                <small id="address-state-help" class="small">Phí ship tính theo vùng giữa tỉnh/bang lấy hàng và giao hàng.</small>
                <small id="address-error-state" class="field-error" role="alert"></small>
                <label for="address-form-city">Phường / xã</label>
                <input
                    id="address-form-city"
                    maxlength="50"
                    autocomplete="address-level2"
                    aria-describedby="address-error-city"
                />
                <small id="address-error-city" class="field-error" role="alert"></small>
                <label for="address-form-street">Đường / số nhà</label>
                <input
                    id="address-form-street"
                    maxlength="100"
                    autocomplete="address-line1"
                    aria-describedby="address-error-street"
                />
                <small id="address-error-street" class="field-error" role="alert"></small>
                <label for="address-form-postalCode">Mã bưu chính (tùy chọn)</label>
                <input
                    id="address-form-postalCode"
                    maxlength="20"
                    autocomplete="postal-code"
                    inputmode="text"
                    aria-describedby="address-error-postalCode address-postal-help"
                />
                <small id="address-postal-help" class="small">Địa chỉ Hoa Kỳ cần ZIP 5 số (Klarna US cũng dùng ZIP này).</small>
                <small id="address-error-postalCode" class="field-error" role="alert"></small>
                <label class="address-default-check">
                    <input type="checkbox" id="address-form-default" />
                    Đặt làm địa chỉ mặc định
                </label>
                <small id="address-form-hint" class="small" hidden></small>
                <div class="dialog-actions">
                    <button type="button" id="address-form-cancel">Hủy</button>
                    <button type="submit" class="primary" id="address-form-save">Lưu địa chỉ</button>
                </div>
            </form>
        </section>
    </div>
</dialog>
