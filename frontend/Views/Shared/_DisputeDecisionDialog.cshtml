<dialog id="decision-dialog" class="decision-dialog" aria-labelledby="decision-title">
    <form id="decision-form">
        <h2 id="decision-title">Phán quyết tranh chấp</h2>
        <p id="decision-context"></p>
        <p class="small">Kết luận phải dựa trên hồ sơ và bằng chứng. Quyết định đã lưu không thể sửa hoặc xóa.</p>
        <p id="decision-error" class="decision-error" role="alert" tabindex="-1" hidden></p>
        <fieldset id="decision-fields">
            <label for="decision-outcome">Kết quả xử lý</label>
            <select id="decision-outcome">
                <option value="FullRefund">Hoàn toàn bộ khoản được nhận theo kết luận</option>
                <option value="PartialRefund">Hoàn một phần</option>
                <option value="SellerWins">Seller thắng, không hoàn thêm</option>
            </select>
            <label for="decision-responsibility">Kết luận trách nhiệm</label>
            <select id="decision-responsibility">
                <option value="Seller">Thuộc trách nhiệm người bán</option>
                <option value="Buyer">Đổi ý hoặc thuộc trách nhiệm người mua</option>
            </select>
            <p class="small">Hệ thống suy ra bên chịu phí từ kết luận. Chưa có vận đơn trả thì không phát sinh phí chiều về; phán quyết này không tạo yêu cầu trả mới.</p>
            <div id="decision-amount-row" hidden>
                <label for="decision-amount">Tiền buyer thực nhận sau phí trả hàng (USD)</label>
                <input id="decision-amount" type="number" min="0.01" step="0.01" inputmode="decimal" />
            </div>
            <h3>Căn cứ quyết định</h3>
            <p class="small">Chọn ít nhất một trao đổi hoặc bằng chứng đã xem trong hồ sơ.</p>
            <div id="decision-evidence" class="decision-evidence"></div>
            <label for="decision-reason">Lý do và nhận định từ bằng chứng</label>
            <textarea id="decision-reason" rows="3" required maxlength="4000"></textarea>
            <button type="button" id="decision-preview">Xem dự kiến tài chính</button>
        </fieldset>
        <div id="decision-quote" aria-live="polite" aria-busy="false"></div>
        <div class="actions decision-actions">
            <button type="button" id="decision-close">Đóng</button>
            <button type="submit" id="decision-confirm" class="primary" disabled>Xác nhận và lưu phán quyết</button>
        </div>
    </form>
</dialog>
