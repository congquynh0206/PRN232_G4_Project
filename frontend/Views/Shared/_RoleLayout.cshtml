@using System.Security.Claims
@{
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var roleLabel = role switch
    {
        "buyer" => "Người mua",
        "seller" => "Người bán",
        "shipper" => "Đơn vị giao hàng",
        "admin" => "Quản trị viên",
        _ => role
    };
    var roleController = role switch
    {
        "buyer" => "Buyer",
        "seller" => "Seller",
        "shipper" => "Shipper",
        "admin" => "Admin",
        _ => "Account"
    };
}
<!doctype html>
<html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"] - Group 4</title>
        <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/roles.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/ui-refresh.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/diagnostics.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/seller-debt.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/seller-levels.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/payouts.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/product-feedback.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/address-changes.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/returns.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/dispute-decisions.css" asp-append-version="true" />
        @if (role == "admin")
        {
            <link rel="stylesheet" href="~/css/platform-fees.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/admin-order-lookup.css" asp-append-version="true" />
        }
        @if (role == "shipper")
        {
            <link rel="stylesheet" href="~/css/vnpost.css" asp-append-version="true" />
        }
        <link rel="stylesheet" href="~/css/dialogs.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/countdowns.css" asp-append-version="true" />
        @if (role is "buyer" or "seller" or "admin")
        {
            <link rel="stylesheet" href="~/css/role-navigation.css" asp-append-version="true" />
        }
    </head>
    <body class="@(role == "shipper" ? "vnpost-workspace" : "")">
        <header class="topbar role-topbar">
            <a class="brand" asp-controller="@roleController" asp-action="Index">
                @if (role == "shipper")
                {
                    <img class="vn-logo" src="~/images/vnpost-logo.png" alt="Vietnam Post" />
                    <span class="vn-brand-text">VNPost<small>Không gian nhân viên giao nhận</small></span>
                }
                else
                {
                    <span class="ebay">
                        <b>e</b>
                        <b>b</b>
                        <b>a</b>
                        <b>y</b>
                    </span>
                    <span>Sàn G4</span>
                }
            </a>
            <div class="account-area">
                <div>
                    <strong>@User.Identity?.Name</strong>
                    <small>@roleLabel</small>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit">Đăng xuất</button>
                </form>
            </div>
        </header>
        <div class="role-banner">
            <small id="realtime-status" role="status" aria-live="polite">Đang kết nối cập nhật trực tiếp…</small>
            @if (role == "shipper")
            {
                <span>VNPost · Quản lý vận đơn</span>
            }
            else
            {
                <span>Không gian làm việc của</span>
                <strong>@roleLabel</strong>
            }
        </div>
        @if (role is "buyer" or "seller" or "admin")
        {
            <div class="workspace-shell workspace-@role @(role == "buyer" ? "" : "has-sidebar")">
                @if (role == "buyer")
                {
                    <partial name="_RoleNavigation" model="role" />
                }
                else
                {
                    <aside id="workspace-sidebar" class="workspace-sidebar">
                        <partial name="_RoleNavigation" model="role" />
                    </aside>
                }
                <main id="workspace-main" class="workspace-main">
                    @if (role != "buyer")
                    {
                        <div class="workspace-mobile-bar">
                            <button
                                type="button"
                                id="navigation-toggle"
                                aria-controls="navigation-drawer"
                                aria-expanded="false"
                                aria-haspopup="dialog"
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    aria-hidden="true"
                                ><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                                Menu @(role == "admin" ? "quản trị" : "người bán")
                            </button>
                            <strong id="navigation-current">@(role == "admin" ? "Tranh chấp" : "Đơn hàng")</strong>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
            @if (role != "buyer")
            {
                <dialog
                    id="navigation-drawer"
                    class="navigation-drawer"
                    aria-labelledby="navigation-drawer-title"
                >
                    <div class="navigation-drawer-head">
                        <h2 id="navigation-drawer-title">Menu @(role == "admin" ? "quản trị" : "người bán")</h2>
                        <button type="button" id="navigation-close" aria-label="Đóng menu">Đóng</button>
                    </div>
                    <div id="navigation-drawer-content"></div>
                </dialog>
            }
        }
        else
        {
            <main>@RenderBody()</main>
        }
        <dialog id="detail-dialog" class="detail-dialog" aria-label="Chi tiết">
            <div class="detail-dialog-head">
                <strong>Chi tiết</strong>
                <button type="button" id="detail-close" aria-label="Đóng chi tiết">Đóng</button>
            </div>
            <div id="detail-content"></div>
        </dialog>
        <dialog
            id="action-dialog"
            class="action-dialog"
            aria-labelledby="action-title"
            aria-describedby="action-context"
        >
            <form id="action-form">
                <h2 id="action-title"></h2>
                <p id="action-context"></p>
                <div id="action-fields" class="dialog-fields"></div>
                <div class="dialog-actions">
                    <button type="button" id="action-cancel">Đóng</button>
                    <button type="submit" class="primary" id="action-confirm">Xác nhận</button>
                </div>
            </form>
        </dialog>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
