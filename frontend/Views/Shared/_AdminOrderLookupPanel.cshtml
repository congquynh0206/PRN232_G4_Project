<section id="order-lookup" class="panel tab-panel diagnostics-panel">
    <div class="section-head">
        <div><span class="eyebrow">Hỗ trợ đơn hàng</span><h1>Tra cứu đơn &amp; giao dịch</h1>
            <p>Tra đơn và xem lịch sử payment, refund, vận chuyển cùng hồ sơ tranh chấp.</p></div>
        <button type="button" id="refresh-order-lookup">Làm mới</button>
    </div>
    <form id="order-lookup-filters" class="diagnostics-filters order-lookup-filters">
        <label>Mã đơn / payment / capture / refund<input name="search" type="search" maxlength="100" placeholder="Nhập mã cần tìm" /></label>
        <label>Buyer<input name="buyer" maxlength="100" placeholder="Tên hoặc email" /></label>
        <label>Seller<input name="seller" maxlength="100" placeholder="Tên hoặc email" /></label>
        <label>Tạo từ<input name="from" type="datetime-local" /></label>
        <label>Tạo đến<input name="to" type="datetime-local" /></label>
        <label>Trạng thái đơn<select name="status"><option value="">Tất cả</option><option value="AwaitingPayment">Chờ thanh toán</option><option value="Paid">Đã thanh toán</option><option value="Preparing">Đang chuẩn bị hàng</option><option value="Shipping">Đang giao hàng</option><option value="Delivered">Đã giao hàng</option><option value="Closed">Hoàn tất</option><option value="Cancelled">Đã hủy</option><option value="Expired">Hết hạn</option></select></label>
        <label>Trạng thái payment<select name="paymentStatus"><option value="">Tất cả</option><option value="Succeeded">Có payment thành công</option><option value="Failed">Có payment lỗi</option><option value="Pending">Có payment đang chờ</option><option value="Verifying">Đang xác minh</option><option value="NotAttempted">Chưa thử thanh toán</option></select></label>
        <label>Trạng thái refund<select name="refundStatus"><option value="">Tất cả</option><option value="Pending">Đang chờ</option><option value="Succeeded">Thành công</option><option value="Failed">Thất bại</option></select></label>
        <div class="diagnostics-filter-actions"><button type="submit" class="primary">Tìm kiếm</button><button type="button" id="clear-order-lookup-filters">Xóa lọc</button></div>
    </form>
    <div class="order-lookup-quick" role="group" aria-label="Lọc nhanh">
        <button type="button" data-lookup-quick="AwaitingPayment">Chờ thanh toán</button>
        <button type="button" data-lookup-quick="PaymentFailed">Có thanh toán lỗi</button>
        <button type="button" data-lookup-quick="HasRefund">Có refund</button>
        <button type="button" data-lookup-quick="HasDispute">Có tranh chấp</button>
    </div>
    <p id="order-lookup-summary" class="small" role="status" aria-live="polite"></p>
    <div class="order-lookup-table-wrap" aria-busy="false"><table class="order-lookup-table"><thead><tr><th>Mã đơn</th><th>Ngày tạo</th><th>Buyer</th><th>Seller</th><th>Tổng tiền</th><th>Thanh toán</th><th>Refund</th><th>Đã hoàn</th><th>Giao hàng</th><th></th></tr></thead><tbody id="order-lookup-rows"></tbody></table></div>
    <div id="order-lookup-empty" class="empty-note" hidden>Không tìm thấy đơn phù hợp.</div>
    <div id="order-lookup-pagination" class="pagination"></div>
</section>
