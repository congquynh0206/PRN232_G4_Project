@{
    var panelId = User.IsInRole("admin") ? "inbox" : "notifications";
}
<section id="@panelId" class="panel tab-panel diagnostics-panel">
    <div class="section-head">
        <div>
            <span class="eyebrow">Thông báo</span>
            <h1>Email thông báo</h1>
            <p>Xem nội dung và kết quả xử lý email về thanh toán, đơn hàng, trả hàng và tài chính.</p>
        </div>
        <button type="button" id="refresh-notifications">Làm mới</button>
    </div>
    <p class="diagnostics-note">
        “Đã lưu để xem” là email demo được lưu trong app, chưa gửi tới hộp thư. Khi bật SMTP, trạng
        thái gửi được theo dõi riêng.
    </p>
    <form id="notification-filters" class="diagnostics-filters">
        <label>Mã đơn<input name="orderId" type="number" min="1" step="1" placeholder="Ví dụ: 46"
        /></label>
        <label>Loại thông báo<select name="eventType">
                <option value="">Tất cả</option>
                <option value="PaymentSucceeded">Thanh toán thành công</option>
                <option value="PaymentFailed">Thanh toán chưa thành công</option>
                <option value="OrderCancelled">Đã hủy đơn chưa thanh toán</option>
                <option value="CancellationRequested">Yêu cầu hủy đơn</option>
                <option value="ReturnRequested">Yêu cầu trả hàng</option>
                <option value="ReturnApproved">Đã duyệt trả hàng</option>
                <option value="ReturnRejected">Đã từ chối trả hàng</option>
                <option value="Delivered">Giao thành công</option>
                <option value="DeliveryFailed">Giao chưa thành công</option>
                <option value="ReattemptScheduled">Đã lên lịch giao lại</option>
                <option value="AddressChangePending">Đổi địa chỉ: chờ seller</option>
                <option value="AddressChangeAwaitingShipper">Đổi địa chỉ: chờ shipper</option>
                <option value="AddressChangeApproved">Địa chỉ mới có hiệu lực</option>
                <option value="AddressChangeRejected">Đổi địa chỉ bị từ chối</option>
                <option value="AddressChangeExpired">Đổi địa chỉ hết hạn</option>
                <option value="Refunded">Hoàn tiền thành công</option>
                @if (User.IsInRole("seller") || User.IsInRole("admin"))
                {
                    <option value="PayoutCompleted">Rút tiền hoàn tất</option>
                    <option value="PayoutReturned">Ngân hàng trả lại khoản rút</option>
                    <option value="DebtStarted">Phát sinh nợ</option>
                    <option value="DebtWarning">Nợ sắp đến hạn</option>
                    <option value="DebtOverdue">Đình chỉ do nợ quá hạn</option>
                    <option value="DebtRepaymentSucceeded">Trả nợ thành công</option>
                    <option value="DebtRepaymentFailed">Trả nợ bị từ chối</option>
                    <option value="DebtCleared">Đã hết nợ</option>
                    <option value="DebtRestored">Gỡ đình chỉ do nợ</option>
                    <option value="DebtWriteOff">Nợ khó thu và khóa bán vĩnh viễn</option>
                    <option value="WriteOffRecovery">Thu hồi nợ sau write-off</option>
                }
            </select></label>
        <label>Trạng thái<select name="status">
                <option value="">Tất cả</option>
                <option value="Captured">Đã lưu để xem</option>
                <option value="Sent">Đã gửi</option>
                <option value="Pending">Chờ gửi / thử lại</option>
                <option value="Processing">Đang xử lý</option>
                <option value="Failed">Lỗi, cần kiểm tra</option>
            </select></label>
        <div class="diagnostics-filter-actions">
            <button type="submit" class="primary">Lọc email</button><button type="button" id="clear-notification-filters">Xóa bộ lọc</button>
        </div>
    </form>
    <p id="notification-summary" class="small" role="status" aria-live="polite"></p>
    <div id="notification-list" class="diagnostics-list" aria-busy="false"></div>
    <div id="notification-pagination" class="pagination"></div>
</section>
