  "cards": [
    {
      "dot": "cyan",
      "title": "Đọc đường đi chính",
      "items": [
        "Trình duyệt → Frontend MVC → API kiểm tra JWT/role → service nghiệp vụ → SQL Server.",
        "Frontend xác thực bằng cookie, proxy gắn JWT của phiên đăng nhập khi gọi backend.",
        "SignalR là đường trực tiếp giữa trình duyệt và API; sự kiện yêu cầu UI tải lại dữ liệu."
      ]
    },
    {
      "dot": "emerald",
      "title": "Hai ứng dụng, các thư viện dùng chung tiến trình",
      "items": [
        "frontend và G4.Api là hai ứng dụng .NET 8. Các node backend là vai trò trong G4.Api, không phải các dịch vụ triển khai riêng.",
        "G4.Application định nghĩa interface use case và tích hợp; G4.Contracts chứa DTO; G4.Domain chứa entity và quy tắc thuần.",
        "G4.Infrastructure triển khai cart/checkout, payment, shipment, return/dispute, seller finance, EF Core và adapter."
      ]
    },
    {
      "dot": "violet",
      "title": "Worker và dữ liệu bền vững",
      "items": [
        "CommerceMaintenanceWorker chạy mỗi 5 giây: đối soát payment, deadline, return/dispute, release tiền, payout, nợ, write-off, level và outbox email.",
        "CommerceChangeWorker đọc thay đổi đã commit mỗi 500 ms, gửi CommerceChanged cho group user/role rồi ghi DispatchedAt.",
        "Outbox và CommerceChange là bảng SQL Server; đây là các luồng nền trong ứng dụng."
      ]
    },
    {
      "dot": "amber",
      "title": "Các tích hợp theo cấu hình source",
      "items": [
        "PayPal dùng Sandbox và cần credential. Luồng chính là capture và reconcile; trạng thái Verifying được worker đối soát.",
        "Carrier mặc định gọi HTTP về chính G4.Api. Endpoint tạo nhãn chỉ chạy ở Development và yêu cầu X-Carrier-Key.",
        "Development gửi SMTP tới MailHog. Khi Mail:Mode = Capture, email chỉ được lưu; sơ đồ chỉ vẽ nhánh SMTP khi được bật.",
        "Thanh toán thẻ và payout ngân hàng là mô phỏng nội bộ; không có cổng thẻ hoặc ngân hàng thật trong sơ đồ."
      ]
    },
    {
      "dot": "slate",
      "title": "Phạm vi và cách kiểm chứng",
      "items": [
        "Kiến trúc tổng quan dựa trên source commit e7997b0. Bấm SRC để xem file và dòng đã ghim theo commit.",
        "Source không xác nhận ứng dụng/provider đang chạy hoặc migration đã áp dụng trên database chính.",
        "Các yêu cầu chưa triển khai trong backlog không được vẽ thành chức năng đã có. Nội dung tiếng Việt; một số điều khiển Archify dùng tiếng Anh.",
        "Thư mục skill .agents/ đang chưa được Git theo dõi; không dùng các file đó làm dẫn chứng kiến trúc ứng dụng."
      ]
    }
  ]
